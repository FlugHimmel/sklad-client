class ScrapEntry {
  final int id;
  final String reason;
  final String quantity;
  ScrapEntry({required this.id, required this.reason, required this.quantity});
  factory ScrapEntry.fromJson(Map<String, dynamic> j) => ScrapEntry(
        id: j['id'] as int,
        reason: (j['reason'] ?? '').toString(),
        quantity: (j['quantity'] ?? '0').toString(),
      );
}

class ProductionRun {
  final int id;
  final int sourceProduct;
  final String sourceProductArticle;
  final String sourceProductName;
  final int product;
  final String productArticle;
  final String productName;
  final String qtySourceUsed;
  final String qtyGood;
  final String qtyScrap;
  final String qtyFromReserve;
  final String qtyReserve;
  final int? order;
  final String? orderNumber;
  final String comment;
  final bool scrapWrittenOff;
  final int? operator;
  final String? operatorUsername;
  final String? operatorFullName;
  final List<ScrapEntry> scrapEntries;
  final DateTime? createdAt;
  final String? createdByUsername;

  ProductionRun({
    required this.id, required this.sourceProduct, required this.sourceProductArticle,
    required this.sourceProductName, required this.product, required this.productArticle,
    required this.productName, required this.qtySourceUsed, required this.qtyGood,
    required this.qtyScrap, required this.qtyFromReserve, required this.qtyReserve,
    this.order, this.orderNumber, required this.comment, required this.scrapWrittenOff,
    this.operator, this.operatorUsername, this.operatorFullName,
    this.scrapEntries = const [], this.createdAt, this.createdByUsername,
  });

  factory ProductionRun.fromJson(Map<String, dynamic> j) {
    return ProductionRun(
      id: j['id'] as int,
      sourceProduct: j['source_product'] as int,
      sourceProductArticle: (j['source_product_article'] ?? '').toString(),
      sourceProductName: (j['source_product_name'] ?? '').toString(),
      product: j['product'] as int,
      productArticle: (j['product_article'] ?? '').toString(),
      productName: (j['product_name'] ?? '').toString(),
      qtySourceUsed: (j['qty_source_used'] ?? '0').toString(),
      qtyGood: (j['qty_good'] ?? '0').toString(),
      qtyScrap: (j['qty_scrap'] ?? '0').toString(),
      qtyFromReserve: (j['qty_from_reserve'] ?? '0').toString(),
      qtyReserve: (j['qty_reserve'] ?? '0').toString(),
      order: j['order'] as int?,
      orderNumber: j['order_number'] as String?,
      comment: (j['comment'] ?? '').toString(),
      scrapWrittenOff: j['scrap_written_off'] as bool? ?? false,
      operator: j['operator'] as int?,
      operatorUsername: j['operator_username'] as String?,
      operatorFullName: j['operator_full_name'] as String?,
      scrapEntries: ((j['scrap_entries'] ?? []) as List)
          .map((e) => ScrapEntry.fromJson(e as Map<String, dynamic>))
          .toList(),
      createdAt: j['created_at'] != null ? DateTime.tryParse(j['created_at'].toString()) : null,
      createdByUsername: j['created_by_username'] as String?,
    );
  }

  String get operatorDisplay {
    if (operatorFullName != null && operatorFullName!.isNotEmpty) return operatorFullName!;
    if (operatorUsername != null) return operatorUsername!;
    return '—';
  }

  String get scrapReasonsDisplay {
    if (scrapEntries.isEmpty) return '';
    return scrapEntries.map((e) => '${e.reason}: ${e.quantity}').join(' · ');
  }
}

class ScrapSummaryRow {
  final int sourceProductId;
  final String sourceProductArticle;
  final String sourceProductName;
  final String qtyScrap;
  final int runsCount;
  ScrapSummaryRow({required this.sourceProductId, required this.sourceProductArticle,
    required this.sourceProductName, required this.qtyScrap, required this.runsCount});
  factory ScrapSummaryRow.fromJson(Map<String, dynamic> j) => ScrapSummaryRow(
        sourceProductId: j['source_product_id'] as int,
        sourceProductArticle: (j['source_product_article'] ?? '').toString(),
        sourceProductName: (j['source_product_name'] ?? '').toString(),
        qtyScrap: (j['qty_scrap'] ?? '0').toString(),
        runsCount: j['runs_count'] as int? ?? 0,
      );
}

class ScrapReport {
  final String? dateFrom; final String? dateTo;
  final String totalScrap; final int totalRuns;
  final List<ScrapReportGroup> byReason;
  final List<ScrapReportGroup> byOperator;
  final List<ScrapReportRow> rows;
  ScrapReport({this.dateFrom, this.dateTo, required this.totalScrap,
    required this.totalRuns, required this.byReason, required this.byOperator,
    required this.rows});
  factory ScrapReport.fromJson(Map<String, dynamic> j) => ScrapReport(
        dateFrom: j['date_from'] as String?, dateTo: j['date_to'] as String?,
        totalScrap: (j['total_scrap'] ?? '0').toString(),
        totalRuns: j['total_runs'] as int? ?? 0,
        byReason: ((j['by_reason'] ?? []) as List).map((e) =>
            ScrapReportGroup(key: (e['reason'] ?? '').toString(),
              qty: (e['qty'] ?? '0').toString())).toList(),
        byOperator: ((j['by_operator'] ?? []) as List).map((e) =>
            ScrapReportGroup(key: (e['operator'] ?? '').toString(),
              qty: (e['qty'] ?? '0').toString())).toList(),
        rows: ((j['rows'] ?? []) as List).map((e) =>
            ScrapReportRow.fromJson(e as Map<String, dynamic>)).toList(),
      );
}

class ScrapReportGroup {
  final String key; final String qty;
  ScrapReportGroup({required this.key, required this.qty});
}

class ScrapReportRow {
  final int id; final DateTime? createdAt;
  final String? operator; final int? operatorId;
  final String sourceProductArticle; final String sourceProductName;
  final String productArticle; final String productName;
  final String qtySourceUsed; final String qtyGood; final String qtyScrap;
  final String scrapReason; final String comment; final bool scrapWrittenOff;
  ScrapReportRow({required this.id, this.createdAt, this.operator, this.operatorId,
    required this.sourceProductArticle, required this.sourceProductName,
    required this.productArticle, required this.productName,
    required this.qtySourceUsed, required this.qtyGood, required this.qtyScrap,
    required this.scrapReason, required this.comment, required this.scrapWrittenOff});
  factory ScrapReportRow.fromJson(Map<String, dynamic> j) => ScrapReportRow(
        id: j['id'] as int,
        createdAt: j['created_at'] != null ? DateTime.tryParse(j['created_at'].toString()) : null,
        operator: j['operator'] as String?, operatorId: j['operator_id'] as int?,
        sourceProductArticle: (j['source_product_article'] ?? '').toString(),
        sourceProductName: (j['source_product_name'] ?? '').toString(),
        productArticle: (j['product_article'] ?? '').toString(),
        productName: (j['product_name'] ?? '').toString(),
        qtySourceUsed: (j['qty_source_used'] ?? '0').toString(),
        qtyGood: (j['qty_good'] ?? '0').toString(),
        qtyScrap: (j['qty_scrap'] ?? '0').toString(),
        scrapReason: (j['scrap_reason'] ?? '').toString(),
        comment: (j['comment'] ?? '').toString(),
        scrapWrittenOff: j['scrap_written_off'] as bool? ?? false,
      );
}
